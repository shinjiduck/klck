# Sao chép thành .env.local và điền giá trị. Không đưa .env.local lên GitHub.

# Token công khai Mapbox (giới hạn theo tên miền trong trang quản lý Mapbox).
# Để trống thì Hue Map hiện khung "Chưa cấu hình bản đồ".
NEXT_PUBLIC_MAPBOX_TOKEN=

# Supabase: Project Settings → API (hoặc nút "Connect"). Để trống thì app dùng dữ liệu giả lib/mock.
NEXT_PUBLIC_SUPABASE_URL=
# Khóa công khai: "Publishable key" (sb_publishable_…) hoặc "anon public" ở dự án cũ – điền MỘT trong hai.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ server – TUYỆT ĐỐI không thêm tiền tố NEXT_PUBLIC_, không đưa lên GitHub. Chưa dùng ở bước này.
# SUPABASE_SERVICE_ROLE_KEY=
